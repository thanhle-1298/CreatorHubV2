# CreatorHub frontend configuration. Copy to .env (never commit real secrets).
# Every value below is public: Vite ships VITE_ variables to the browser.

# Which Arc network the app uses: mainnet (default) or testnet
VITE_NETWORK=mainnet

# CreatorHub V2 contract (escrow + ratings). Required.
VITE_CREATOR_HUB_V2_ADDRESS=

# CreatorHub V1 contract (legacy, read-only). Defaults to the live mainnet V1 when VITE_NETWORK=mainnet.
VITE_CREATOR_HUB_V1_ADDRESS=

# Optional: your own RPC URL for the active network (otherwise the public Arc RPC is used)
VITE_RPC_URL=

# Optional: public URL of the deployed app, for example https://creatorhub.example.com
VITE_APP_URL=
